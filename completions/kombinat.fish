# fish completion for kombinat; generated by `kombinat completion fish`, do not edit.
function __kombinat_at --argument-names want
    set -l toks (commandline -opc)
    set -e toks[1]
    set -l typed
    for t in $toks
        string match -q -- '-*' $t; or set -a typed $t
    end
    set -l got (string join ' ' -- $typed)
    test "$got" = "$want"
end
complete -c kombinat -f
complete -c kombinat -l json -d 'Print data as JSON'
complete -c kombinat -l no-color -d 'Plain output without colors (also NO_COLOR)'
complete -c kombinat -l help -d 'Show help (also -h)'

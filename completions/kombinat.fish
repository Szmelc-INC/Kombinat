# fish completion for kombinat; generated by `kombinat completion fish`, do not edit.
function __kombinat_at --argument-names want
    set -l toks (commandline -opc)
    set -e toks[1]
    set -l typed
    for t in $toks
        string match -q -- '-*' $t; or set -a typed $t
    end
    set -l got (string join ' ' -- $typed)
    test "$got" = "$want"
end
complete -c kombinat -f
complete -c kombinat -l json -d 'Print data as JSON'
complete -c kombinat -l no-color -d 'Plain output without colors (also NO_COLOR)'
complete -c kombinat -l help -d 'Show help (also -h)'
complete -c kombinat -n '__kombinat_at \'\'' -a 'completion' -d 'Print the shell completion script (bash, zsh, fish)'
complete -c kombinat -n '__kombinat_at \'\'' -a 'config' -d 'Inspect the merged configuration'
complete -c kombinat -n '__kombinat_at \'\'' -a 'help' -d 'Show help for kombinat or one command'
complete -c kombinat -n '__kombinat_at \'\'' -a 'log' -d 'Show the event log, oldest first'
complete -c kombinat -n '__kombinat_at \'\'' -a 'serve' -d 'Serve the HTTP JSON API on 127.0.0.1 until interrupted'
complete -c kombinat -n '__kombinat_at \'\'' -a 'version' -d 'Print the core version'
complete -c kombinat -n '__kombinat_at \'completion\'' -a 'bash'
complete -c kombinat -n '__kombinat_at \'completion\'' -a 'zsh'
complete -c kombinat -n '__kombinat_at \'completion\'' -a 'fish'
complete -c kombinat -n '__kombinat_at \'config\'' -a 'show' -d 'Print the merged config as JSON: core plus every module, or one of them'
complete -c kombinat -n '__kombinat_at \'help\'' -a 'completion'
complete -c kombinat -n '__kombinat_at \'help\'' -a 'config'
complete -c kombinat -n '__kombinat_at \'help\'' -a 'help'
complete -c kombinat -n '__kombinat_at \'help\'' -a 'log'
complete -c kombinat -n '__kombinat_at \'help\'' -a 'serve'
complete -c kombinat -n '__kombinat_at \'help\'' -a 'version'
complete -c kombinat -n '__kombinat_at \'log\'' -l tail -r -d 'Show the last N events (default 20, max 1000)'

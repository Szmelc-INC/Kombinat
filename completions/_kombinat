#compdef kombinat
# zsh completion for kombinat; generated by `kombinat completion zsh`, do not edit.
_kombinat() {
  local -a typed vals
  local w p
  for w in "${(@)words[2,CURRENT-1]}"; do
    [[ $w == -* ]] || typed+=("$w")
  done
  p="${(j: :)typed}"
  if [[ $PREFIX == -* ]]; then
    case $p in
    esac
    vals+=('--json:Print data as JSON')
    vals+=('--no-color:Plain output without colors (also NO_COLOR)')
    vals+=('--help:Show help (also -h)')
    _describe -t flags 'kombinat flag' vals
    return
  fi
  case $p in
    '') vals=('completion:Print the shell completion script (bash, zsh, fish)' 'config:Inspect the merged configuration' 'help:Show help for kombinat or one command' 'version:Print the core version') ;;
    'completion') vals=('bash' 'zsh' 'fish') ;;
    'config') vals=('show:Print the merged config as JSON: core plus every module, or one of them') ;;
    'help') vals=('completion' 'config' 'help' 'version') ;;
  esac
  (( ${#vals} )) && _describe -t values 'kombinat' vals
}
_kombinat "$@"
